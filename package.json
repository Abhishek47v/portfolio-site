{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build && node scripts/csp-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "gate:tokens": "node scripts/check-tokens.mjs",
    "verify": "npm run check && npm run gate:tokens && npm run build && npm run test",
    "serve": "node scripts/serve.mjs",
    "content:status": "node scripts/content-status.mjs",
    "deploy": "node scripts/check-site-url.mjs && wrangler deploy",
    "deploy:preview": "node scripts/check-site-url.mjs && wrangler versions upload"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.62.1",
    "axe-core": "4.13.0",
    "typescript": "^6.0.3",
    "wrangler": "4.129.0"
  }
}
