---
/**
 * Avatar — an illustrated portrait: hoodie, modern crop, no photograph.
 *
 * Inline SVG rather than an `<img>`, for the same reason as every other
 * illustration here: an image cannot inherit a custom property, and that
 * inheritance is the theming mechanism. The hoodie and the skin are token
 * roles, so the figure sits in the same light as the sky behind it and
 * crossfades with everything else on a theme change.
 *
 * Entirely decorative — the hero already says who this is in text — so it is
 * aria-hidden and contributes nothing to the accessible name.
 *
 * Optional by design: `site.avatar` decides whether it renders at all, and
 * with it off the hero is purely typographic exactly as before.
 */
---

<svg
  class="avatar"
  viewBox="0 0 120 120"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id="avatar-disc">
      <circle cx="60" cy="60" r="59" />
    </clipPath>
  </defs>

  <circle class="disc" cx="60" cy="60" r="59" />

  <g clip-path="url(#avatar-disc)">
    <!-- shoulders, then the neck, then the hood collar over the top of it -->
    <path class="hoodie" d="M10 120C12 99 28 89 43 85h34c15 4 31 14 33 35Z" />
    <path class="skin-shade" d="M52 62h16v28H52Z" />
    <path
      class="hoodie-shade"
      d="M40 86c6 10 34 10 40 0 7 5 11 14 9 23-13 7-45 7-58 0-2-9 2-18 9-23Z"
    />

    <!-- head -->
    <ellipse class="skin-shade" cx="37" cy="54" rx="4.6" ry="5" />
    <ellipse class="skin-shade" cx="83" cy="54" rx="4.6" ry="5" />
    <ellipse class="skin" cx="60" cy="50" rx="22" ry="25" />

    <!-- the crop: full on top, sweeping across the brow from the right -->
    <path
      class="hair"
      d="M37 54C34 30 45 20 60 20s26 11 23 34c-1-9-4-14-8-18-7 6-19 8-28 5-5-2-9 4-10 13Z"
    />

    <ellipse class="ink" cx="51" cy="56" rx="2" ry="2.6" />
    <ellipse class="ink" cx="69" cy="56" rx="2" ry="2.6" />
    <path class="mouth" d="M55 66c3 3 7 3 10 0" />

    <!-- drawstrings -->
    <path class="cord" d="M54 96c-1 8-1 14 0 20M66 96c1 8 1 14 0 20" />
    <circle class="cord-tip" cx="54" cy="117" r="1.9" />
    <circle class="cord-tip" cx="66" cy="117" r="1.9" />
  </g>

  <circle class="ring" cx="60" cy="60" r="58.5" />
</svg>

<style>
  .avatar { display: block; width: 100%; height: auto; }

  .disc { fill: var(--surface); }
  .ring { fill: none; stroke: var(--edge); stroke-width: 1; }

  .skin { fill: var(--skin); }
  .skin-shade { fill: var(--skin-shade); }
  .hair { fill: var(--hair); }
  .ink { fill: var(--hair); }
  .hoodie { fill: var(--hoodie); }
  .hoodie-shade { fill: var(--hoodie-shade); }

  .mouth {
    fill: none;
    stroke: var(--skin-shade);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .cord {
    fill: none;
    stroke: var(--hoodie-cord);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .cord-tip { fill: var(--hoodie-cord); }
</style>
