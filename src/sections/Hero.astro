---
import { site } from '../data/site';
import Character from '../illustration/Character.astro';

/* The typewriter erases to nothing between roles, so the line would collapse
   and reflow on every swap if nothing held the width open. Reserve the longest
   role instead of a guessed constant — add a role and the reserve follows. */
const widest = Math.max(...site.roles.map((r) => r.length));
---

<section id="about" class="hero" data-section-name="About" aria-labelledby="hero-name">
  <div class="wrap inner" data-reveal>
    <div class="intro-row">
      <p class="greeting">Hey — I'm</p>
      {site.character && <div class="figure"><Character /></div>}
    </div>
    <h1 id="hero-name">{site.name}</h1>

    <p class="doing">
      <span class="and">and I do</span>
      <span
        class="rotator"
        aria-hidden="true"
        data-roles={site.roles.join('|')}
        style={`--roles-ch:${widest}`}
      >
        <span class="word">{site.roles[0]}</span>
      </span>
      <span class="visually-hidden">{site.roles.join(', ')}.</span>
    </p>

    <p class="intro">{site.intro}</p>

  </div>
</section>

<style>
  /* No surface at all — the hero sits directly on the sky. At display sizes
     the ink clears contrast against every sky stop, so a panel here would be
     protecting text that does not need protecting (D-030). */

  /* Takes the space the stats strip leaves and centres its content in it,
     rather than setting a fixed height of its own. Every size below is capped
     against viewport *height* as well as width — on a short laptop screen the
     width-based clamps alone are what push the strip under the fold. */
  /* Sized by its content now, not by the space available: .first-screen
     centres the whole group, so the hero no longer needs to grow and centre
     within itself. That is what closed the gap between the description and
     the numbers. */
  .hero {
    flex: 0 1 auto;
    padding-block: clamp(1rem, 3vh, 2rem) clamp(.75rem, 2.5vh, 1.5rem);
  }
  /* Left-aligned, as it was. Only the *stats* strip is centred; the
     introduction reads as prose and prose is set ragged-right from a left
     edge. What changed here is vertical: the hero now sizes itself to the
     space the strip leaves. */
  .inner { display: flex; flex-direction: column; gap: var(--s-3); }

  /* He lies *beside* the greeting rather than above it, which puts him in the
     empty band to the right of the short line and gives the first screen back
     the vertical space he used to take. Bottom-aligned so the greeting sits at
     his level, directly above the name. */
  /* The figure is out of flow, and that is the whole point. In flow it set
     the height of this row, and that height *was* the gap between the greeting
     and the name — it was never margin, so no amount of margin tuning could
     close it. Absolutely positioned, the row is exactly as tall as the words
     "Hey — I'm", and he reclines in the space above the name rather than
     pushing it down. Remove him and the layout is unchanged. */
  .intro-row {
    position: relative;
    margin-bottom: var(--s-2);
  }
  /* Left offset clears the greeting; the width puts his body over the back
     half of the name, so he lies above "shek Verma" rather than over all of
     it. The vh term keeps him from climbing into the header on a short
     window — he grows upward from the greeting's baseline. */
  .figure {
    position: absolute;
    left: clamp(4rem, 10vw, 7.5rem);
    /* Low enough to sit down on the greeting's line, not so low that his legs
       land on the name's ascenders — at -1.5rem he collided with the title on
       every short viewport. tests/first-screen.spec.ts holds this. */
    bottom: -1rem;
    /* The vh term is what stops him climbing into the sticky header: he
       grows upward from the greeting, so his height is bounded by the space
       above it, and that space scales with the viewport. 58vh collided at
       1280x800. */
    width: min(26rem, 52vw, 42vh);
    pointer-events: none;
  }

  /* No horizontal room to lie beside a line this narrow — back into the flow,
     above the greeting, where he costs height but at least fits. */
  @media (max-width: 720px) {
    .intro-row { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); }
    .figure { position: static; order: -1; width: min(100%, 17rem, 34vh); }
  }

  /* Larger and in full --ink rather than synthetically bolded: IBM Plex Mono
     ships a single weight here, and faux bold on 12px uppercase mono thickens
     the stems unevenly and closes the counters. Size and ink buy the same
     visibility without the smear (the same reason the display face is never
     bolded — D-040). */
  .greeting {
    font-family: var(--font-mono);
    font-size: .88rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  h1 { margin-bottom: var(--s-2); font-size: min(var(--step-4), 12vh); }

  /* Stays in the display serif at its single weight. A sans-semibold version
     was tried and reverted: it pulled the eye away from the name directly above
     it, and the accent colour already separates the role from the sentence.
     The weight contrast on this page belongs to the stats strip alone (D-042).
     Height-capped so it cannot push the strip below the fold. */
  .doing {
    font-family: var(--font-display);
    font-size: min(clamp(1.5rem, 1rem + 2.4vw, 2.6rem), 5.5vh);
    line-height: 1.25;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4em;
  }
  .and { color: var(--ink-soft); }
  .rotator {
    /* Roman, not italic. The italic was the only one on the page and, set in a
       high-contrast display serif at hero size, it read as decorative rather
       than emphatic. The accent colour already does the work of setting the
       role apart from the sentence around it. */
    color: var(--accent);
    /* Holds the longest role open so the line never reflows mid-type. `ch` is
       the width of a zero, which in this face is wider than the lowercase the
       roles are actually set in — so this over-reserves slightly, which is the
       safe direction to be wrong in. */
    min-width: calc(var(--roles-ch, 10) * 1ch);
  }

  .intro {
    margin-top: var(--s-3);
    /* Two lines on a desktop measure, which this copy only reaches by giving
       up some size: at --step-1 it ran to three however wide the box got, and
       the box is already at the limit of --wrap. ~110 characters a line is
       well past the 65-75 that reads comfortably, so this is a composition
       decision paid for in readability. Shorter real copy is the proper fix —
       this text is still PROVISIONAL (D-045). */
    font-size: clamp(1rem, .92rem + .28vw, 1.12rem);
    line-height: 1.62;
    color: var(--ink-soft);
    max-width: 58rem;
  }


  /* Short screens — the 768px and 700px laptops. The width-based clamps have
     no idea the viewport is shallow, and the intro is the tallest single
     element in the hero, so it is what gets trimmed first. */
  @media (max-height: 780px) {
    .inner { gap: var(--s-2); }
    .intro { font-size: var(--step-0); line-height: 1.45; margin-top: var(--s-2); }
  }

  /* Tablets and phones. --bar-h becomes 98px at this width because the nav
     drops to its own row, which is 12% of a phone viewport gone before the
     hero starts. Trim begins here, not at the phone breakpoint. */
  @media (max-width: 860px) {
    .figure { left: clamp(3.5rem, 9vw, 6rem); width: min(22rem, 52vw, 38vh); }
    .intro { font-size: var(--step-0); line-height: 1.48; }
  }

  /* Phones. The intro runs to seven lines at this measure and is the single
     biggest cost above the fold. */
  @media (max-width: 560px) {

    .doing { font-size: clamp(1.3rem, 6vw, 1.7rem); }
    .intro { font-size: .94rem; line-height: 1.42; }
  }

  /* Genuinely short viewports — a 650px-tall window, or a phone in landscape.
     Past this point there is nothing left to trim politely. */
  @media (max-height: 700px) {
    .hero { padding-block: var(--s-3); }
    .inner { gap: 6px; }
    .figure { width: min(21rem, 50vw, 36vh); }
    h1 { margin-bottom: 2px; }
    .intro { font-size: .95rem; line-height: 1.4; margin-top: 4px; }
  }
</style>
