---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import Sky from '../illustration/Sky.astro';
import Ridges from '../illustration/Ridges.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AudioToggle from '../components/AudioToggle.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import { hasLink, hasPublicFile } from '../lib/assets';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasResume = hasLink(site.links.resume);
const hasAudio = hasPublicFile(site.audio);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {site.ogImage && <meta property="og:image" content={new URL(site.ogImage, Astro.site)} />}
    <!-- A large card without an image renders as a blank rectangle, so the
         claim is only made when there is something to show. -->
    <meta name="twitter:card" content={site.ogImage ? 'summary_large_image' : 'summary'} />

    <!-- Both faces are used above the fold; the mono is not. -->
    <link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/karla-300600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Blocking on purpose: the theme must be settled before first paint. -->
    <script src="/theme-init.js" is:inline></script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Sky />
    <Ridges />

    <header class="bar">
      <div class="wrap bar-inner">
        <a class="bar-name" href="/">Abhishek Verma</a>
        <Nav />
        <div class="bar-right">
          {hasAudio && <AudioToggle />}
          {/* Directly left of the theme toggle: the résumé is the one thing
              someone may want at any point on the page, so it sits with the
              persistent controls rather than at the far end of the row. */}
          {hasResume && (
            <a class="bar-cta" href={site.links.resume} target="_blank" rel="noopener">Résumé</a>
          )}
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- The last line of the page. data-reveal, so it arrives as you reach the
         bottom rather than sitting there the whole way down; with scripts off
         it is simply present. No panel, no cloud and no hairline — the page
         ends on the sky, the same way Contact above it does (D-053). --ink
         because bare sky will not carry --ink-faint at this size. -->
    <footer class="foot" data-reveal>
      <div class="foot-inner">
        <p class="colophon label">
          © {new Date().getFullYear()} — developed by{' '}
          <a href={site.links.linkedin} target="_blank" rel="noopener">Abhishek</a>
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/main.ts';
    </script>

    <style>
      .bar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--surface);
        border-bottom: 1px solid var(--edge);
        backdrop-filter: blur(12px) saturate(115%);
        -webkit-backdrop-filter: blur(12px) saturate(115%);
      }
      .bar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-5);
        height: var(--bar-h);
      }
      .bar-name {
        font-family: var(--font-display);
        font-size: 1.02rem;
        text-decoration: none;
      }
      .bar-right {
        display: flex;
        align-items: center;
        gap: var(--s-5);
      }
      /* A button, not an underlined word. It sits between the audio and theme
         controls, both of which are bordered squares, and an underline there
         read as a fourth nav item rather than as something to press. Its own
         class, not .action: that one is sized for the first screen and would
         be 22px too tall for a 60px bar. */
      .bar-cta {
        font-family: var(--font-mono);
        font-size: .68rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        text-decoration: none;
        padding: 6px 13px;
        border: 1px solid var(--edge);
        border-radius: 999px;
        white-space: nowrap;
        transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
      }
      .bar-cta:hover { color: var(--ink); border-color: var(--accent); }
      /* Set well below the last section: the page has ended, and the line that
         ends it should not look like part of Contact. */
      .foot {
        padding: clamp(4.5rem, 10vw, 8rem) 0 var(--s-7);
      }
      .foot-inner {
        width: 100%;
        max-width: var(--wrap);
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 4rem);
      }
      /* On a veil like every other piece of text. Sitting straight on the
         ridge put this at roughly 1.3:1 (D-029). */
      @media (max-width: 860px) {
        .bar-inner {
          flex-wrap: wrap;
          height: auto;
          padding-block: var(--s-3);
          row-gap: var(--s-3);
        }
        .bar-right { margin-left: auto; }
      }

      .colophon { max-width: none; color: var(--ink); text-align: center; }
      .colophon a { text-decoration-thickness: 1px; }

    </style>
  </body>
</html>
