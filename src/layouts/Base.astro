---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import Sky from '../illustration/Sky.astro';
import Ridges from '../illustration/Ridges.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AudioToggle from '../components/AudioToggle.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import { hasPublicFile } from '../lib/assets';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasResume = hasPublicFile(site.links.resume);
const hasAudio = hasPublicFile(site.audio);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {site.ogImage && <meta property="og:image" content={new URL(site.ogImage, Astro.site)} />}
    <!-- A large card without an image renders as a blank rectangle, so the
         claim is only made when there is something to show. -->
    <meta name="twitter:card" content={site.ogImage ? 'summary_large_image' : 'summary'} />

    <!-- Both faces are used above the fold; the mono is not. -->
    <link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/karla-300600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Blocking on purpose: the theme must be settled before first paint. -->
    <script src="/theme-init.js" is:inline></script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Sky />
    <Ridges />

    <header class="bar">
      <div class="wrap bar-inner">
        <a class="bar-name" href="/">Abhishek Verma</a>
        <Nav />
        <div class="bar-right">
          {hasResume && <a class="bar-link" href={site.links.resume}>Résumé</a>}
          {hasAudio && <AudioToggle />}
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="sheet">
        <p class="colophon label">
          Built as a static site — no framework runtime, no third-party requests,
          and a contrast test that runs on every commit.
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/main.ts';
    </script>

    <style>
      .bar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--surface);
        border-bottom: 1px solid var(--edge);
        backdrop-filter: blur(12px) saturate(115%);
        -webkit-backdrop-filter: blur(12px) saturate(115%);
      }
      .bar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-5);
        height: 60px;
      }
      .bar-name {
        font-family: var(--font-display);
        font-size: 1.02rem;
        text-decoration: none;
      }
      .bar-right {
        display: flex;
        align-items: center;
        gap: var(--s-5);
      }
      .bar-link {
        font-family: var(--font-mono);
        font-size: .72rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        text-decoration: none;
        border-bottom: 1px solid var(--edge);
        padding-bottom: 2px;
      }
      .bar-link:hover { color: var(--ink); border-bottom-color: var(--accent); }
      /* The sheet runs to the foot of the page, so the colophon sits inside
         it rather than floating below on the ridge. */
      .foot {
        padding: 0 0 var(--s-8);
      }
      /* On a veil like every other piece of text. Sitting straight on the
         ridge put this at roughly 1.3:1 (D-029). */
      .colophon {
        padding: var(--s-5) clamp(1.25rem, 5vw, 4rem) var(--s-6);
        border-top: 1px solid var(--edge);
        max-width: none;
      }

    </style>
  </body>
</html>
