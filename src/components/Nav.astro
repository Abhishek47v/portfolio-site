---
/**
 * Section shortcuts. Real anchors, so they work with JavaScript off and can be
 * copied and shared; the active state is the only scripted part.
 */
/* Order matters twice over: these are the shortcuts, and nav.ts resolves the
   active one by taking the first of these keys that is on screen. Keep this
   list in document order or the highlight lags behind the page.

   'About' points at the hero rather than at a section of its own — the
   introduction is the hero, and a second block restating it was the weakest
   thing on the page. */
const items: { href: string; label: string; watch?: string }[] = [
  /* '#top' is the document's own top, not an element — the HTML spec defines
     that fragment when nothing matches it. The hero starts a little below the
     fold's top (.first-screen has a margin and the section has padding), so
     '#about' landed short of the page top by exactly that much. `watch` keeps
     the highlight pointed at the real #about element (D-055). */
  { href: '#top', label: 'About', watch: 'about' },
  { href: '#work', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="nav" aria-label="Sections">
  <ul>
    {items.map((i) => (
      <li><a href={i.href} data-nav={i.watch ?? i.href.slice(1)}>{i.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .nav ul {
    display: flex;
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    font-family: var(--font-mono);
    font-size: .71rem;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .nav a:hover { color: var(--ink); }
  .nav a.is-current { color: var(--ink); border-bottom-color: var(--accent); }

  /* Below the desktop breakpoint the nav drops to its own full-width row and
     scrolls sideways. No hamburger, no overlay, no JavaScript — the shortcuts
     stay reachable on a phone, which is where they were missing entirely. */
  @media (max-width: 860px) {
    .nav {
      order: 2;
      width: 100%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav::-webkit-scrollbar { display: none; }
    .nav ul { gap: var(--s-4); padding-bottom: 2px; }
    .nav a { white-space: nowrap; }
  }
</style>
